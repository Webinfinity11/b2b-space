generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Users & auth ───────────────────────────────

enum PlatformRole {
  USER
  ADMIN
  FINANCE_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

model User {
  id                 String       @id @default(cuid())
  firstName          String
  lastName           String
  email              String       @unique
  phone              String?
  passwordHash       String
  platformRole       PlatformRole @default(USER)
  status             UserStatus   @default(ACTIVE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  emailNotifications Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions              Session[]
  memberships           CompanyMember[]
  createdCompanies      Company[]                 @relation("CompanyCreatedBy")
  offers                Offer[]
  responses             OfferResponse[]
  participations        ConversationParticipant[]
  messages              Message[]
  dealVersionsCreated   DealTermsVersion[]
  dealApprovals         DealApproval[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  verificationDecisions VerificationDecision[]
  verificationDocuments VerificationDocument[]
  paymentRecords        PaymentRecord[]
  invoiceStatusChanges  InvoiceStatusChange[]
  invitationsSent       CompanyInvitation[]
  reports               Report[]                  @relation("ReportReporter")
  reportsHandled        Report[]                  @relation("ReportHandler")

  @@index([platformRole])
  @@index([status])
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────── Companies ───────────────────────────────

enum BusinessRole {
  BUYER
  SELLER
  BOTH
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
}

enum DealStage {
  INTEREST
  OFFER
  NEGOTIATION
  MEETING
  CONTRACT
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MemberRole {
  OWNER
  EMPLOYEE
  FINANCE
}

enum MemberStatus {
  ACTIVE
  REMOVED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// OFFER = special-offer category; INDUSTRY = company industry; POSITION / DEPARTMENT = employee lists.
  kind      String   @default("INDUSTRY")
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]        @relation("CategoryTree")
  companies         CompanyCategory[]
  offers            Offer[]
  positionMembers   CompanyMember[]   @relation("MemberPosition")
  departmentMembers CompanyMember[]   @relation("MemberDepartment")

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Company {
  id                 String             @id @default(cuid())
  slug               String             @unique
  legalName          String
  tradeName          String?
  registrationNumber String
  taxNumber          String?
  country            String             @default("GE")
  city               String?
  legalAddress       String
  description        String?
  activities         String?
  /// Free-text activity area when none of the listed categories fits.
  customCategory     String?
  website            String?
  facebookUrl        String?
  linkedinUrl        String?
  instagramUrl       String?
  contactPerson      String
  contactEmail       String
  contactPhone       String?
  showEmailPublicly  Boolean            @default(false)
  showPhonePublicly  Boolean            @default(false)
  logoUrl            String?
  coverUrl           String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  businessRole       BusinessRole       @default(BOTH)
  size               CompanySize        @default(SMALL)
  /// Who to contact directly (e.g. "კორპორაციული გაყიდვები").
  direction          String?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  createdBy             User                      @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  categories            CompanyCategory[]
  members               CompanyMember[]
  invitations           CompanyInvitation[]
  media                 CompanyMedia[]
  verificationDocuments VerificationDocument[]
  verificationDecisions VerificationDecision[]
  offers                Offer[]
  responses             OfferResponse[]
  participations        ConversationParticipant[]
  dealsAsSeller         DealTerms[]               @relation("DealSellerCompany")
  dealsAsBuyer          DealTerms[]               @relation("DealBuyerCompany")
  approvals             DealApproval[]
  invoicesAsSeller      Invoice[]                 @relation("InvoiceSellerCompany")
  invoicesAsBuyer       Invoice[]                 @relation("InvoiceBuyerCompany")
  commissions           Commission[]
  campaignRequests      CampaignRequest[]
  campaignInbox         CampaignRecipient[]

  @@unique([country, registrationNumber])
  @@index([verificationStatus])
  @@index([country, city])
  @@index([createdAt])
}

model CompanyCategory {
  companyId  String
  categoryId String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([companyId, categoryId])
  @@index([categoryId])
}

model CompanyMember {
  id          String       @id @default(cuid())
  companyId   String
  userId      String
  role        MemberRole   @default(EMPLOYEE)
  /// Fine-grained permissions for EMPLOYEE / FINANCE members (see src/lib/permissions.ts). OWNER has all.
  permissions String[]     @default([])
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Job title and department, chosen from admin-managed lists (Category kind POSITION / DEPARTMENT).
  positionId   String?
  departmentId String?

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Category? @relation("MemberPosition", fields: [positionId], references: [id], onDelete: SetNull)
  department Category? @relation("MemberDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([positionId])
  @@index([userId])
}

model CompanyInvitation {
  id           String     @id @default(cuid())
  companyId    String
  email        String
  role         MemberRole @default(EMPLOYEE)
  permissions  String[]   @default([])
  firstName    String?
  lastName     String?
  positionId   String?
  departmentId String?
  tokenHash    String     @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([email])
}

enum MediaType {
  IMAGE
  VIDEO
}

model CompanyMedia {
  id        String    @id @default(cuid())
  companyId String
  type      MediaType
  url       String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
}

/// Private document. `storageKey` points to the private upload dir; never served publicly.
model VerificationDocument {
  id           String   @id @default(cuid())
  companyId    String
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model VerificationDecision {
  id         String             @id @default(cuid())
  companyId  String
  reviewerId String
  fromStatus VerificationStatus
  toStatus   VerificationStatus
  comment    String?
  createdAt  DateTime           @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
}

// ─────────────────────────────── Offers & requests ───────────────────────────────

enum OfferType {
  OFFER
  REQUEST
}

enum ItemKind {
  PRODUCT
  SERVICE
}

enum PriceType {
  FIXED
  FROM
  RANGE
  NEGOTIABLE
  NONE
}

enum OfferVisibility {
  PUBLIC
  REGISTERED
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  ACCEPTING_RESPONSES
  NEGOTIATING
  CLOSED
  EXPIRED
  ARCHIVED
}

model Offer {
  id             String          @id @default(cuid())
  type           OfferType
  title          String
  description    String
  categoryId     String?
  itemKind       ItemKind        @default(PRODUCT)
  priceType      PriceType       @default(NONE)
  priceMin       Decimal?        @db.Decimal(18, 2)
  priceMax       Decimal?        @db.Decimal(18, 2)
  currency       String?
  quantity       Decimal?        @db.Decimal(18, 3)
  unit           String?
  deliveryTerms  String?
  country        String?         @default("GE")
  city           String?
  validUntil     DateTime?
  authorUserId   String
  companyId      String?
  /// When true the public site/API never exposes author or company identity.
  isAnonymous    Boolean         @default(false)
  /// Special member condition shown in green, e.g. "−20%".
  perk           String?
  /// Who the offer is for.
  audience       String?
  /// Badge set by platform admins (მთავარი პარტნიორი, …).
  badgeId        String?
  /// Platform commission for deals from this offer (percent) and its display text.
  commissionPct  Decimal?        @db.Decimal(5, 2)
  commissionText String?
  visibility     OfferVisibility @default(PUBLIC)
  status         OfferStatus     @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  badge         OfferBadge?       @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  author        User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  company       Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attachments   OfferAttachment[]
  responses     OfferResponse[]
  conversations Conversation[]

  @@index([status, type, publishedAt])
  @@index([categoryId])
  @@index([companyId])
  @@index([authorUserId])
  @@index([badgeId])
}

model OfferAttachment {
  id        String   @id @default(cuid())
  offerId   String
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  isImage   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

enum ResponseStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model OfferResponse {
  id                 String         @id @default(cuid())
  offerId            String
  responderUserId    String
  responderCompanyId String?
  message            String
  status             ResponseStatus @default(SENT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  offer            Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  responder        User          @relation(fields: [responderUserId], references: [id], onDelete: Restrict)
  responderCompany Company?      @relation(fields: [responderCompanyId], references: [id], onDelete: Restrict)
  conversation     Conversation?

  @@index([offerId, createdAt])
  @@index([responderUserId])
  @@index([responderCompanyId])
}

// ─────────────────────────────── Conversations ───────────────────────────────

model Conversation {
  id            String           @id @default(cuid())
  offerId       String?
  responseId    String?          @unique
  subject       String
  stage         DealStage        @default(INTEREST)
  amount        Decimal?         @db.Decimal(18, 2)
  /// Commission percent for this deal (falls back to the offer's).
  commissionPct Decimal?         @db.Decimal(5, 2)
  /// Direct chats (no offer): which side sells. null = the contacted company (AUTHOR) sells.
  sellerSide    ParticipantSide?
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  offer        Offer?                    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  response     OfferResponse?            @relation(fields: [responseId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  dealTerms    DealTerms?
  commissions  Commission[]

  @@index([offerId])
  @@index([lastMessageAt])
}

enum ParticipantSide {
  AUTHOR
  RESPONDER
}

model ConversationParticipant {
  id               String          @id @default(cuid())
  conversationId   String
  userId           String
  companyId        String?
  side             ParticipantSide
  /// Whether this participant's identity is shown to the other side (anonymous requests).
  identityRevealed Boolean         @default(true)
  lastReadAt       DateTime?
  createdAt        DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([companyId])
}

enum MessageKind {
  TEXT
  FILE
  SYSTEM
  TERMS
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String?
  kind           MessageKind @default(TEXT)
  body           String
  fileUrl        String?
  fileName       String?
  fileMime       String?
  fileSize       Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────── Deal terms ───────────────────────────────

enum DealStatus {
  DRAFT
  SENT_FOR_APPROVAL
  CHANGES_REQUESTED
  APPROVED_BY_ONE
  APPROVED_BY_BOTH
  SUPERSEDED
  CANCELLED
}

enum DealSide {
  SELLER
  BUYER
}

model DealTerms {
  id               String   @id @default(cuid())
  conversationId   String   @unique
  sellerUserId     String
  buyerUserId      String
  sellerCompanyId  String?
  buyerCompanyId   String?
  currentVersionId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sellerCompany  Company?           @relation("DealSellerCompany", fields: [sellerCompanyId], references: [id], onDelete: Restrict)
  buyerCompany   Company?           @relation("DealBuyerCompany", fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  versions       DealTermsVersion[] @relation("DealVersions")
  currentVersion DealTermsVersion?  @relation("DealCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
}

/// Immutable once sent for approval — every change creates a new version.
model DealTermsVersion {
  id             String     @id @default(cuid())
  dealTermsId    String
  versionNumber  Int
  status         DealStatus @default(DRAFT)
  currency       String
  discountAmount Decimal    @default(0) @db.Decimal(18, 2)
  taxRatePercent Decimal?   @db.Decimal(5, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(18, 2)
  deliveryTerms  String?
  deliveryCost   Decimal    @default(0) @db.Decimal(18, 2)
  subtotal       Decimal    @db.Decimal(18, 2)
  total          Decimal    @db.Decimal(18, 2)
  paymentTerms   String?
  validUntil     DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime   @default(now())

  dealTerms DealTerms       @relation("DealVersions", fields: [dealTermsId], references: [id], onDelete: Cascade)
  currentOf DealTerms?      @relation("DealCurrentVersion")
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     DealTermsItem[]
  approvals DealApproval[]
  invoice   Invoice?

  @@unique([dealTermsId, versionNumber])
}

model DealTermsItem {
  id          String  @id @default(cuid())
  versionId   String
  name        String
  description String?
  quantity    Decimal @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  version DealTermsVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

model DealApproval {
  id        String           @id @default(cuid())
  versionId String
  side      DealSide
  userId    String
  companyId String?
  decision  ApprovalDecision
  comment   String?
  createdAt DateTime         @default(now())

  version DealTermsVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([versionId, side])
}

// ─────────────────────────────── Invoices ───────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique
  dealTermsVersionId String        @unique
  sellerCompanyId    String?
  buyerCompanyId     String?
  sellerUserId       String
  buyerUserId        String
  status             InvoiceStatus @default(ISSUED)
  issuedAt           DateTime      @default(now())
  dueDate            DateTime?
  currency           String
  subtotal           Decimal       @db.Decimal(18, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(18, 2)
  deliveryCost       Decimal       @default(0) @db.Decimal(18, 2)
  total              Decimal       @db.Decimal(18, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(18, 2)
  /// Buyer confirmed delivery / payment (triggers the SGBA commission).
  buyerConfirmedAt   DateTime?
  buyerConfirmedById String?
  /// Seller's own signed invoice or contract attached to this deal invoice (private storage key).
  documentKey        String?
  documentName       String?
  documentMime       String?
  /// Commission percent frozen when the invoice was issued (null = use the deal's current one).
  commissionPct      Decimal?      @db.Decimal(5, 2)
  paymentTerms       String?
  notes              String?
  /// Frozen copy of seller/buyer legal data and terms at the moment of creation.
  snapshot           Json
  correctsInvoiceId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  dealTermsVersion DealTermsVersion      @relation(fields: [dealTermsVersionId], references: [id], onDelete: Restrict)
  sellerCompany    Company?              @relation("InvoiceSellerCompany", fields: [sellerCompanyId], references: [id], onDelete: Restrict)
  buyerCompany     Company?              @relation("InvoiceBuyerCompany", fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  correctsInvoice  Invoice?              @relation("InvoiceCorrections", fields: [correctsInvoiceId], references: [id], onDelete: Restrict)
  corrections      Invoice[]             @relation("InvoiceCorrections")
  items            InvoiceItem[]
  payments         PaymentRecord[]
  statusHistory    InvoiceStatusChange[]
  commission       Commission?

  @@index([sellerCompanyId, status])
  @@index([buyerCompanyId, status])
  @@index([sellerUserId])
  @@index([buyerUserId])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  name        String
  description String?
  quantity    Decimal @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceStatusChange {
  id          String         @id @default(cuid())
  invoiceId   String
  fromStatus  InvoiceStatus?
  toStatus    InvoiceStatus
  changedById String
  comment     String?
  createdAt   DateTime       @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
}

/// Manually recorded payment (no payment provider yet). Never created automatically.
model PaymentRecord {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(18, 2)
  currency     String
  paidAt       DateTime
  method       String?
  reference    String?
  note         String?
  recordedById String
  /// Admin voided a mistaken entry (kept for the audit trail, excluded from totals).
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

// ─────────────────────────────── Notifications, moderation, audit ───────────────────────────────

enum NotificationType {
  NEW_RESPONSE
  NEW_REPLY
  NEW_MESSAGE
  TERMS_SENT
  TERMS_APPROVED
  TERMS_REJECTED
  INVOICE_CREATED
  PAYMENT_DUE_SOON
  INVOICE_OVERDUE
  COMPANY_STATUS_CHANGED
  MEMBER_INVITED
  CAMPAIGN
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  status      ReportStatus @default(OPEN)
  handledById String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum CommissionStatus {
  CONFIRMED
  SETTLED
  CANCELLED
}

/// Platform commission, created when an invoice of a deal is fully paid.
model Commission {
  id             String           @id @default(cuid())
  invoiceId      String           @unique
  conversationId String?
  companyId      String?
  currency       String
  baseAmount     Decimal          @db.Decimal(18, 2)
  pct            Decimal          @db.Decimal(5, 2)
  amount         Decimal          @db.Decimal(18, 2)
  status         CommissionStatus @default(CONFIRMED)
  /// SGBA commission invoice number issued to the seller (SGBA-YYYY-000001).
  number         String?          @unique
  ruleId         String?
  /// Why an admin cancelled / adjusted it.
  note           String?
  settledAt      DateTime?
  createdAt      DateTime         @default(now())

  rule         CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status, createdAt])
}

/// Commission models shown in Finance (managed by admins).
model CommissionRule {
  id          String   @id @default(cuid())
  title       String
  /// Shown to users, e.g. "1–3%".
  rate        String
  /// Percent applied automatically (null = display only).
  pct         Decimal? @db.Decimal(5, 2)
  /// Offer categories this rule covers (empty = any category).
  categoryIds String[] @default([])
  /// Applies only when the deal base is at least this amount (large corporate deals).
  minAmount   Decimal? @db.Decimal(18, 2)
  /// Upper limit of the commission amount.
  capAmount   Decimal? @db.Decimal(18, 2)
  /// Fallback when no other rule matches.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  commissions Commission[]
}

/// Paid campaign packages.
model CampaignPackage {
  id        String   @id @default(cuid())
  kind      String
  title     String
  audience  String
  channels  String
  priceFrom Decimal  @db.Decimal(18, 2)
  accent    String   @default("blue")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests CampaignRequest[]
}

enum CampaignRequestStatus {
  NEW
  IN_PROGRESS
  APPROVED
  RUNNING
  DONE
  REJECTED
}

/// A company's application for a campaign (package or custom).
model CampaignRequest {
  id          String                @id @default(cuid())
  packageId   String?
  companyId   String
  userId      String
  title       String
  message     String?
  status      CampaignRequestStatus @default(NEW)
  adminNote   String?
  /// Audience filters (empty = all).
  industryIds String[]              @default([])
  cities      String[]              @default([])
  sizes       String[]              @default([])
  roles       String[]              @default([])
  positions   String?
  /// Target employees by position (Category kind POSITION ids). Empty = any position.
  positionIds String[]              @default([])
  perk        String?
  ctaUrl      String?
  fileUrl     String?
  fileName    String?
  startDate   DateTime?
  /// Final price set by the admin.
  price       Decimal?              @db.Decimal(18, 2)
  paidAt      DateTime?
  launchedAt  DateTime?
  finishedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  package    CampaignPackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([status, createdAt])
  @@index([companyId])
}

/// A company that received a launched campaign (delivery + results).
model CampaignRecipient {
  id        String    @id @default(cuid())
  requestId String
  companyId String
  viewedAt  DateTime?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  request CampaignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([requestId, companyId])
  @@index([companyId])
}

/// Admin-managed offer badges (e.g. "მთავარი პარტნიორი"). showBanner = featured on the dashboard banner.
model OfferBadge {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("blue")
  showBanner  Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  offers Offer[]
}
